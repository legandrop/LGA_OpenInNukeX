/* Tema oscuro para LGA_OpenInNukeX */

/* Estilo general para la aplicación */
QWidget {
    background-color: #161616; /* bg_principal */
    color: #B2B2B2;  /* txt_principal */
    font-family: "Inter", Arial, Helvetica;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0px;
}

/* Estilo para labels */
QLabel {
    color: #B2B2B2;  /* txt_principal */
    background-color: transparent;
    padding: 2px 0px;
    font-family: "Inter", Arial, Helvetica;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0px;
}

/* Estilo para los menús (❌❌) */
QMenuBar {
    background-color: #BC8320;
    color: #4FBE29;
}

QMenuBar::item:selected {
    background-color: #C0B51B; /* ❌❌❌ */
}

QMenu {
    background-color: #1d1d1d; /* Este es el color raro que aparecia amarillo en dropdowns en mac */
    color: #528532;          /* ❌❌❌ */
    border: 1px solid border_principal; /* Borde del popover */
}

QMenu::item:selected {
    background-color: #C122DA; /* ❌❌❌ */
}

/* ------------------------------ Estilos para botones ------------------------------ */
/* Botón primario gris */
QPushButton {
    background-color: #2a2a2a; /* boton_gris_oscuro */
    color: #B2B2B2; /* txt_principal */
    border: none;
    padding: 6px 12px;
    border-radius: 5px;
    font-family: "Inter", Arial, Helvetica;
    font-size: 14px;
    font-weight: 450;
    letter-spacing: 0px;
}

QPushButton:hover {
    background-color: #3a3a3a; /* boton_gris_oscu_hover */
}

QPushButton:pressed {
    background-color: #3a3a3a; /* boton_gris_oscu_hover */
}

QPushButton:disabled {
    background-color: #2a2a2a; /* boton_gris_oscuro */
    color: #9D9D9D;
}

/* Botón secundario (gris) */
QPushButton.secondary {
    background-color: #3b3b3b;
    color: #B2B2B2; /* txt_principal */
    border-radius: 4px;
}

QPushButton.secondary:hover {
    background-color: #636363;
}

QPushButton.secondary:pressed {
    background-color: #636363;
}

/* Botón de acción (violeta) */
/*
 * NO redeclarar `font-size` aca: la familia y el cuerpo salen del `QPushButton` de arriba
 * (Inter 14px), que es el que se ve bien.
 *
 * Antes habia DOS `font-size` en esta misma regla —`11pt` y despues `0.65rem`— y ganaba la
 * ultima. **Qt Style Sheets no soporta `rem`**: acepta `px`, `pt`, `em` y `ex`. Cada
 * plataforma resolvia esa unidad invalida a su manera, asi que el boton violeta salia con la
 * letra diminuta en macOS y con el cuerpo correcto en Windows. Solo queda el peso, que es la
 * unica diferencia buscada contra el boton gris.
 */
QPushButton.action {
    background-color: #443a91; /* violeta_oscuro */
    color: #B2B2B2; /* txt_principal */
    font-weight: 700;
}

QPushButton.action:hover {
    background-color: #774dcb; /* violeta_claro */
}

QPushButton.action:pressed {
    background-color: #774dcb; /* violeta_claro */
}

/* ------------------------------ Estilos para campos de entrada de texto ------------------------------ */
QLineEdit, QTextEdit {
    background-color: #1d1d1d; /* bg_items */
    color: #B2B2B2; /* txt_principal */
    border: 1px solid #303030; /* border_principal */
    padding: 8px;
    padding-top: 12px;
    border-radius: 5px;
    font-family: "Inter", Arial, Helvetica;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0px;
}

/* Estilo para dropdowns comunes (LOS DE SETTINGS SON ESTOS) (solo la caja sin desplegar) ✅ */
QComboBox {
    background-color: bg_items; 
    color: txt_principal; 
    border: 1px solid border_principal; 
    padding: 6px 8px;
    border-radius: 3px;
    min-height: 20px;
    font-family: "Inter", Arial, Helvetica;
    font-size: 15px;  /* Tamaño body2 en Material-UI */
    font-weight: 400;  /* Regular weight para body text */
    line-height: 1.4;  /* Espaciado vertical como en la versión anterior */
    letter-spacing: 0px;  /* Espaciado de letras sutil */    
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid border_principal; /* Borde izquierdo de la flechita del dropdown ✅ */
}

/* Añadiendo flecha SVG a los ComboBox generales (settings) */
QComboBox::down-arrow {
    image: url(:/icons/dropdown_arrow_white.svg);
    width: 8px;
    height: 8px;
}

/* Estilo específico para el dropdown del toolbar */
QComboBox#projectFilter, QComboBox#statusFilter, QComboBox#sortOrderFilter, QComboBox#assigneeFilter {
    background-color: bg_items; 
    color: txt_principal; 
    border: 1px solid border_principal; 
    padding: 2px 8px;  /* Padding vertical aumentado a 6px */
    border-radius: 3px;
    min-height: 20px;
    font-family: "Inter", Arial, Helvetica;
    font-size: 13px;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0px;
}

QComboBox#projectFilter::drop-down, QComboBox#statusFilter::drop-down, QComboBox#sortOrderFilter::drop-down, QComboBox#assigneeFilter::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid border_principal;
}

/* Añadiendo flecha SVG a los ComboBox del toolbar */
QComboBox#projectFilter::down-arrow, QComboBox#statusFilter::down-arrow, QComboBox#sortOrderFilter::down-arrow, QComboBox#assigneeFilter::down-arrow {
    image: url(:/icons/dropdown_arrow_white.svg);
    width: 8px;
    height: 8px;
}

/* Estilo específico para el filtro de proyectos cuando está filtrado (flecha roja) */
QComboBox#projectFilter[filtered="true"]::down-arrow {
    image: url(:/icons/dropdown_arrow_red.svg);
    width: 8px;
    height: 8px;
}

/* Estilo específico para el filtro de status cuando está filtrado (flecha roja) */
QComboBox#statusFilter[filtered="true"]::down-arrow {
    image: url(:/icons/dropdown_arrow_red.svg);
    width: 8px;
    height: 8px;
}

/* Estilo específico para el filtro de assignees cuando está filtrado (flecha roja) */
QComboBox#assigneeFilter[filtered="true"]::down-arrow {
    image: url(:/icons/dropdown_arrow_red.svg);
    width: 8px;
    height: 8px;
}

/* ------------------------------ Estilos para Settings ------------------------------ */
/* Estilo para los títulos de cada sección de settings (File Association, Preferred Nuke Version)
 * El violeta es el mismo token `titulo_seccion` (#775ECF) que usan PipeSync y FileManagerS3
 * para los títulos de sección: la convención LGA es que se vean iguales entre apps. */
QLabel#sectionTitle {
    color: #775ECF;
    font-family: "Inter", Arial, Helvetica;
    font-weight: 500;
    font-size: 20px;
    letter-spacing: 0px;
}

/* Estilo para fondos de cada widget de settings.
 * El radio es el token `radio_card` (8px) de PipeSync, por la misma razón que el color del
 * título: los bloques de settings tienen que verse iguales en todas las apps LGA. */
QGroupBox {
    background-color: #1d1d1d; /* bg_items */
    border: none;
    border-radius: 8px;
    margin-top: 1ex;
    padding-top: 10px;
    padding-bottom: 10px;
}

/* Fondo transparente para el contenedor principal de versiones */
QWidget#versionsMainContainer {
    background-color: transparent;
}

/* Fondo transparente para el widget que contiene los botones de versión */
QWidget#versionsButtonsContainer {
    background-color: transparent;
}

/* Estilo para el texto del checkbox de settings ✅ */
QCheckBox {
    color: txt_principal; /* Texto del checkbox de settings ✅ */
    padding: 5px;
    background-color: transparent;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    background-color: #2A2A2A; /* Fondo del checkbox sin seleccionar ✅ */
    border: 1px solid border_principal; /* Borde del checkbox sin seleccionar ✅ */
    border-radius: 3px;
}

QCheckBox::indicator:checked {
    background-color: #2A2A2A;   /* Fondo del checkbox seleccionado ✅ */
    image: url(:/icons/checkmark.svg);
}

/* ------------------------------ Estilos para scrollbars ------------------------------ */
QScrollBar:vertical {
    background-color: #161616; /* bg_principal */
    width: 12px;
    margin: 0px;
    border-radius: 0px;
}

QScrollBar::handle:vertical {
    background-color: #1d1d1d; /* bg_items */
    min-height: 30px;
    border-radius: 3px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #303030; /* border_principal */
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    background: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

/* Estilo específico para el área de desplazamiento */
QScrollArea#darkScrollArea {
    background-color: #161616; /* bg_principal */
    border: none;
}

/* Estilo para el widget central de settings */
QScrollArea#darkScrollArea QWidget#centralSettingsWidget {
    background-color: #161616; /* bg_principal */
    padding-bottom: 20px;
}

/* Estilo para el widget de settings */
QScrollArea#darkScrollArea QWidget#contentSettingsWidget {
    background-color: #161616; /* bg_principal */
}

/* Estilo para grupos sin borde */
QGroupBox#settingsGroup {
    border: none;
}

/* Texto descriptivo debajo del titulo de cada bloque.
 * Antes cada label traia su propio setStyleSheet inline con el mismo color repetido; al
 * unificarlos aca el color de "texto secundario" queda definido en UN solo lugar. */
QLabel#sectionDescription {
    color: #8A8A8A;
    font-size: 15px;
}

QLabel#versionLabel {
    color: #8A8A8A;
    font-size: 15px;
}

/* Estado del escaner de versiones. El color sale de la propiedad `state` y no de un
 * setStyleSheet inline, asi que cambiarlo NO pisa el resto de la hoja. */
QLabel#scanStatus {
    color: #4A9EFF;
    font-size: 15px;
    font-style: italic;
}

QLabel#scanStatus[state="empty"] {
    color: #FF6B6B;
}

/* ------------------------------ Diálogos (Dialogs) ------------------------------ */
/* Los diálogos se crean con `ConfigWindow` de padre, así que Qt les aplica TAMBIÉN esta hoja
 * por herencia de la cadena de padres. El `QLabel { padding: 2px 0px; }` de arriba les caía
 * encima: el icono es un QLabel de 32x32 con un pixmap de 32x32, y ese padding le dejaba un
 * content rect de 32x28, o sea el icono RECORTADO 2 px arriba y 2 abajo. Al label de texto le
 * sumaba 4 px de alto que la medición manual del componente no contempla, corriendo justo la
 * alineación que Doc_Dialogs.md pide medir y no mirar.
 *
 * Esto NO es estilo del diálogo —eso vive todo en DialogStyle.h y ahí se queda—: es
 * neutralizar una regla de ESTA app para que no se derrame sobre un componente compartido. */
QDialog#lgaDialog QLabel {
    padding: 0px;
}

/* ------------------------------ Nuke Bridge ------------------------------ */
/* Chip de estado. Los tres estados: sin instalar (gris), instalado (verde) y instalado en
 * otra version (amarillo, porque ahi SI hay algo que hacer). */
QLabel#bridgeChip {
    font-size: 12px;
    font-weight: 700;
    padding: 4px 9px;
    border-radius: 3px;
    background-color: #2a2a2a;
    color: #9D9D9D;
}

QLabel#bridgeChip[state="on"] {
    background-color: #253320;
    color: #7CB868; 
}

QLabel#bridgeChip[state="stale"] {
    background-color: #35300f;
    color: #D8C43A;
}

QLabel#bridgeHint {
    color: #8A8A8A;
    font-size: 13px;
}

QWidget#manualPanel {
    background-color: transparent;
    border-top: 1px solid #303030;
}

QLabel#manualSteps {
    color: #8A8A8A;
    font-size: 13px;
}

/* La linea que el usuario tiene que pegar en su init.py: monoespaciada y en su propia caja,
 * para que se lea como algo a copiar y no como parte de la explicacion.
 *
 * El texto va en gris comun y NO en violeta: el violeta es el color de los titulos de seccion
 * y de los botones de accion, asi que aca sugeria una jerarquia que esta linea no tiene. */
QLabel#manualCode {
    background-color: #161616;
    border: 1px solid #303030;
    border-radius: 3px;
    padding: 8px 10px;
    color: #B2B2B2;
    font-family: "SF Mono", Menlo, Consolas, monospace;
    font-size: 13px;
}

/* Boton que despliega las instrucciones manuales. Antes era `class="link"`: azul, sin caja y
 * sin borde, o sea con la pinta de un enlace que lleva a otro lado, cuando en realidad abre
 * contenido en esta misma ventana. Con caja y borde se lee como lo que es. */
QPushButton.toggle {
    background-color: #2a2a2a;
    border: 1px solid #3b3b3b;
    border-radius: 5px;
    color: #B2B2B2;
    padding: 6px 14px;
    font-size: 13px;
    font-weight: 500;
    text-align: center;
}

QPushButton.toggle:hover {
    background-color: #3a3a3a;
    border-color: #5D5D5D;
    color: #D6D6D6;
}

QPushButton.toggle:pressed {
    background-color: #3a3a3a;
    border-color: #5D5D5D;
}

/* ------------------------------ Selector de idioma ------------------------------ */
QPushButton.lang {
    background-color: transparent;
    border: 1px solid #303030;
    border-radius: 0px;
    color: #8A8A8A;
    font-size: 11px;
    font-weight: 700;
    padding: 2px 0px;
}

QPushButton.lang:hover {
    color: #B2B2B2;
}

QPushButton.lang[selected="true"] {
    background-color: #3a3a3a;
    color: #D6D6D6;
}

/* ------------------------------ Estilo general para selección de texto ------------------------------ */
* {
    selection-background-color: #383838;
    selection-color: #ffffff;
}

/* ------------------------------ Estilos específicos para el dropdown de status y su popup ------------------------------ */
QComboBox#statusComboBox {
    border: none;
    border-radius: 3px;
    padding: 0 8px;
    min-height: 24px;
    max-height: 24px;
    font-size: 13px;
    font-family: "Inter", Arial, Helvetica;
}

/* Centrar el texto y hacer toda el área clickeable */
QComboBox#statusComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right;
    width: 28px;
    border: none;
    background: transparent;
}

QComboBox#statusComboBox::down-arrow {
    image: url(:/icons/dropdown_arrow.svg);
    width: 16px;
    height: 16px;
}

/* Estilo para el texto cuando el combobox está cerrado */
QComboBox#statusComboBox {
    padding-left: 8px;
    padding-right: 8px;
}

/* Estilos para el popup */
QComboBox#statusComboBox QAbstractItemView {
    background-color: #1E1E1E;
    border: 1px solid #2F2F2F;
    border-radius: 3px;
    padding: 4px;
    color: txt_principal;
    selection-background-color: #2F2F2F;
    selection-color: txt_principal;
}

QComboBox#statusComboBox QAbstractItemView::item {
    min-height: 32px;
    padding: 4px 8px;
}

QComboBox#statusComboBox QAbstractItemView::item:selected {
    background-color: #2F2F2F;
}

/* ------------------------------ Estilos para la tabla de versiones ------------------------------ */
QWidget#shotCardVersions {
    background-color: transparent;
}

QWidget#versionRow {
    background-color: transparent;
}

QWidget#versionLocalGroup, QWidget#versionRemoteGroup {
    background-color: transparent;
}

/* Contenedores para el texto MOV Review y el botón FlowNotes */
QWidget#movReviewTextContainer {
    background-color: transparent;
    margin-right: 0;
    padding-right: 0;
}

QWidget#flowNotesButtonContainer {
    background-color: transparent;
    margin-left: 0;
    padding-left: 0;
}

QLabel#versionTypeLabel {
    color: #ADADAD;
    font-family: "Inter", Arial, Helvetica;
    font-size: 14px;
    font-weight: 500;
    background-color: transparent;
}

QLabel#versionNumberLabel {
    color: #ADADAD;
    font-family: "Inter", Arial, Helvetica;
    font-size: 14px;
    font-weight: 500;
    background-color: transparent;
}

/* ------------------------------ Estilos para tooltips personalizados ------------------------------ */
/* Estilo para el tooltip */
QLabel#tooltipLabel {
    color: txt_principal;
    background-color: transparent;
    font-family: "Inter", Arial, Helvetica;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0px;
    padding: 0px;
    margin: 0;
    width: auto;
}

/* ------------------------------ Estilos para botones de versiones de Nuke ------------------------------ */
/* Botón de versión de Nuke - Selector ultra específico */
QWidget#versionsButtonsContainer QPushButton[class="version"] {
    background-color: #303030 !important; 
    color: #B2B2B2 !important; /* txt_principal */
    border-radius: 16px !important;
    padding: 8px 16px !important;
    font-family: "Inter", Arial, Helvetica !important;
    font-size: 13px !important;
    font-weight: 500 !important;
    letter-spacing: 0px !important;
    min-width: 80px !important;
}

QWidget#versionsButtonsContainer QPushButton[class="version"]:hover {
    background-color: #5D5D5D !important; 
}

QWidget#versionsButtonsContainer QPushButton[class="version"]:pressed {
    background-color: #6D6D6D !important; 
}


